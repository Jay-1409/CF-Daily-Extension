{
    "manifest_version": 3,
    "name": "CF-Daily",
    "version": "2.0.0",
    "description": "One shared Codeforces Problem of the Day for every rating",
    "content_scripts": [
        {
            "css": [
                "src/styles.css"
            ],
            "js": [
                "src/config.js",
                "src/potd.js",
                "src/cloud.js",
                "src/script.js"
            ],
            "matches": [
                "https://codeforces.com/problemset*"
            ]
        },
        {
            "css": [
                "src/heatmap.css"
            ],
            "js": [
                "src/config.js",
                "src/potd.js",
                "src/cloud.js",
                "src/profile.js"
            ],
            "matches": [
                "https://codeforces.com/profile/*"
            ]
        }
    ],
    "action": {
        "default_icon": "icons/icon16.png",
        "default_popup": "src/popup.html",
        "default_title": "CF-Daily"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "identity",
        "storage"
    ],
    "oauth2": {
        "client_id": "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
        "scopes": [
            "openid",
            "email",
            "profile"
        ]
    },
    "host_permissions": [
        "https://codeforces.com/*",
        "https://identitytoolkit.googleapis.com/*",
        "https://securetoken.googleapis.com/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
    ]
}
