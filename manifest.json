{
    "manifest_version": 3,
    "name": "CF-Daily",
    "version": "2.1.2",
    "key": "",
    "description": "One shared Codeforces Problem of the Day for every rating",
    "background": {
        "service_worker": "src/background.js"
    },
    "content_scripts": [
        {
            "css": [
                "src/styles.css"
            ],
            "js": [
                "src/config.js",
                "src/potd.js",
                "src/cloud.js",
                "src/script.js"
            ],
            "matches": [
                "https://codeforces.com/problemset*"
            ]
        },
        {
            "css": [
                "src/heatmap.css"
            ],
            "js": [
                "src/config.js",
                "src/potd.js",
                "src/cloud.js",
                "src/profile.js"
            ],
            "matches": [
                "https://codeforces.com/profile/*"
            ]
        }
    ],
    "action": {
        "default_icon": "icons/icon16.png",
        "default_popup": "src/popup.html",
        "default_title": "CF-Daily"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "identity",
        "storage"
    ],
    "host_permissions": [
        "https://codeforces.com/*",
        "https://*.supabase.co/*",
        "https://cf-daily-extension.vercel.app/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
    ]
}
