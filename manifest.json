{
    "manifest_version": 3,
    "name": "CF-Daily",
    "version": "1.5.0",
    "description": "One shared Codeforces Problem of the Day for every rating",
    "content_scripts": [
        {
            "css": [
                "src/styles.css"
            ],
            "js": [
                "src/potd.js",
                "src/script.js"
            ],
            "matches": [
                "https://codeforces.com/problemset*"
            ]
        },
        {
            "css": [
                "src/heatmap.css"
            ],
            "js": [
                "src/potd.js",
                "src/profile.js"
            ],
            "matches": [
                "https://codeforces.com/profile/*"
            ]
        }
    ],
    "action": {
        "default_icon": "icons/icon16.png",
        "default_popup": "src/popup.html",
        "default_title": "CF-Daily"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://codeforces.com/*"
    ]
}
